# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fetch Configuration
FETCH_TIMEOUT=30000
MAX_RETRIES=3

# Storage Configuration
BATCH_SIZE=1000

# Scheduling Configuration
SCHEDULE_TIME=02:00

# Alerting Configuration
FRESHNESS_THRESHOLD_HOURS=48
ERROR_RATE_THRESHOLD=0.05

# CVM Data Source
CVM_API_URL=https://dados.cvm.gov.br/api/...
CVM_API_KEY=your-cvm-api-key

# BACEN Data Sources
BACEN_SGS_URL=https://api.bcb.gov.br/...
BACEN_PTAX_URL=https://api.bcb.gov.br/...

# B3 Data Source
B3_API_URL=https://b3.com.br/api/...
B3_API_KEY=your-b3-api-key