# Brazilian Financial Data pipeline — fetch / parse / store only.
# Copy to .env and fill in. Used by `python -m src.pipeline.run_daily`
# and `python -m src.pipeline.run_backfill`.

# Storage — Supabase Postgres (project: Silo / zcjbtpxuhdekpwcxmepn, region sa-east-1)
# Apply schema once:  python scripts/apply_schema.py
# Get the connection strings from: Supabase Dashboard -> Silo -> Connect.
#
# Rules for every URL below:
#   - no quotes and no spaces around the value;
#   - a password with @ / : # ? must have those characters percent-encoded
#     (@ -> %40, / -> %2F, : -> %3A, # -> %23, ? -> %3F);
#   - never use the dedicated/transaction pooler (db.<ref>.supabase.co:6543):
#     the ingest and the analytical apply need session features.
#
# LOCAL (this form): direct connection (port 5432) — verified for DDL/migrations
#   and bulk upserts from psycopg2.
POSTGRES_URL=postgresql://postgres:<password>@db.zcjbtpxuhdekpwcxmepn.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:<password>@db.zcjbtpxuhdekpwcxmepn.supabase.co:5432/postgres?sslmode=require

# SESSION POOLER (IPv4) — what CI uses. The direct host is IPv6-only per the notes
# in scripts/finish_cutover.sh and GH runners are IPv4-only, so the GitHub Actions
# secret POSTGRES_URL must be this URL, not the direct one above.
# scripts/rotate_db_password.sh and scripts/finish_cutover.sh read it from here.
#   - host: aws-1-sa-east-1.pooler.supabase.com, port 5432 (confirmed 2026-10-05:
#     that host answers "password authentication failed" for this project). The
#     host aws-0-sa-east-1 does NOT know it: "(ENOTFOUND) tenant/user ... not found".
#   - user: postgres.zcjbtpxuhdekpwcxmepn  (role, a dot, the project ref).
#   - to check a host without the password: a known host answers "password
#     authentication failed", a wrong one answers "tenant/user not found".
# To rotate the password: reset it in Supabase, then `bash scripts/rotate_db_password.sh`.
SUPABASE_POOLER_URL=postgresql://postgres.zcjbtpxuhdekpwcxmepn:<password>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# CVM fetcher network tuning
CVM_DNS_NAMESERVERS=1.1.1.1,8.8.8.8,9.9.9.9
CVM_REQUEST_TIMEOUT=300
CVM_MAX_RETRIES=3
CVM_RETRY_DELAY=5
CVM_UPSERT_CHUNK_SIZE=1000
CVM_INGEST_CONCURRENCY=4
CVM_DAILY_CONCURRENCY=6
CVM_DAILY_SCOPE=core

# B3 COTAHIST (public historical quotation zips)
# B3_COTAHIST_BASE_URL=https://bvmf.bmfbovespa.com.br/InstDados/SerHist
# B3_DAILY_LOOKBACK_DAYS=7
# B3_REQUEST_TIMEOUT=300
# B3_MAX_RETRIES=3

# Misc
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# Public read API (`python -m serve.app`). Prefer a role that can only
# SELECT/EXECUTE api.* — never the ingest postgres user in production.
# SILO_API_DATABASE_URL=postgresql://silo_api:<password>@db.zcjbtpxuhdekpwcxmepn.supabase.co:5432/postgres?sslmode=require
# SILO_API_HOST=127.0.0.1
# SILO_API_PORT=8080

# Portfolio diagnosis, engine 1.12 (#605): the investigator of official documents.
# SILO_INVESTIGATOR=on runs it in the server; its web fallback reads the Exa key (never logged).
# SILO_INVESTIGATOR=
# EXA_API_KEY=
# SILO_INVESTIGATOR_EXTRACTOR_MODEL=
# SILO_INVESTIGATOR_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Keys the pipeline does not need locally. Most live ONLY as GitHub Actions
# secrets (Settings -> Secrets and variables -> Actions), never in .env:
#   gh secret set <NAME>      (GitHub secrets are write-only, so keep the
#                              source of each value in your password manager)
# Only POSTGRES_URL is required for CI to run at all; the rest switch on one
# workflow or feature each, and the feature self-skips or the workflow fails
# loudly when its key is missing.
#
# Ingest (daily_ingest.yml, market_backfill.yml, watchdog)
#   POSTGRES_URL           GitHub secret: SESSION pooler URL (port 5432), see above
#   EIA_API_KEY            GitHub secret: US EIA energy series (free key)
#   APIFY_TOKEN            GitHub secret: ETF NAV snapshot; self-skips when unset
# Dashboard publish (daily_ingest.yml, publish_check.yml)
#   VERCEL_DEPLOY_HOOK_URL GitHub secret: the hook that republishes dashboard/
#   VERCEL_TOKEN           GitHub secret: lets publish_check read the build state
# Remote MCP (deploy_mcp.yml)
#   SUPABASE_ACCESS_TOKEN  GitHub secret: personal access token for `supabase functions deploy`
# Portfolio-diagnosis Worker on Cloudflare (deploy_cloudflare.yml)
#   CLOUDFLARE_ACCOUNT_ID  GitHub secret: the account id (needs Workers Paid)
#   CLOUDFLARE_API_TOKEN   GitHub secret: account-owned token with "Edit Cloudflare Workers"
#   OPENAI_API_KEY         GitHub secret: copied into the Worker as a Worker secret
#                          (also used by probe_openai_models.yml)
#   DEMO_ACCESS_TOKEN      GitHub secret: gate for the demo; copied into the Worker
#   EXA_API_KEY            GitHub secret: investigator web fallback (#605); copied into the Worker
# Repository VARIABLES (Settings -> Secrets and variables -> Actions -> Variables)
#   BACEN_SGS_BASE_URL     optional override of the BACEN SGS endpoint
#   CBOE_VIX_LICENSED      set only if you hold a Cboe licence
#
# To run the Worker's pieces locally, export the same names in your shell or here:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# OPENAI_API_KEY=
# LLM engine selection (defaults are fine): SILO_LLM_PROVIDER=anthropic|openai|fake,
# SILO_LLM_MODEL, SILO_LLM_EFFORT, SILO_LLM_FALLBACKS
