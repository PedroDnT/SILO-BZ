# Brazilian Financial Data pipeline — fetch / parse / store only.
# Copy to .env and fill in. Used by `python -m src.pipeline.run_daily`
# and `python -m src.pipeline.run_backfill`.

# Storage — Neon Postgres (project: iliquid-project)
# Apply schema once:  psql $POSTGRES_URL -f src/store/schema.sql
# Prefer the pooled (-pooler) connection string for automated ingestion / CI.
# Keep a direct connection string for schema migrations and admin maintenance.
POSTGRES_URL=postgresql://<user>:<password>@<ep-xxx-pooler>.us-east-2.aws.neon.tech/<db>?sslmode=require

# Neon API key (for branch management via Neon MCP / CLI)
API_NEON_ILLIQUID=postgresql://neondb_owner:npg_z76STIyDdtnV@ep-raspy-credit-aqbbq518-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require 

# CVM fetcher network tuning
CVM_DNS_NAMESERVERS=1.1.1.1,8.8.8.8,9.9.9.9
CVM_REQUEST_TIMEOUT=300
CVM_MAX_RETRIES=3
CVM_RETRY_DELAY=5
CVM_UPSERT_CHUNK_SIZE=1000
CVM_INGEST_CONCURRENCY=4
CVM_DAILY_CONCURRENCY=6
CVM_DAILY_SCOPE=core

# Misc
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# Flask control plane (local dev only — bind to 127.0.0.1)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=1
