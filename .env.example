# Brazilian Financial Data pipeline — fetch / parse / store only.
# Copy to .env and fill in. Used by `python -m src.pipeline.run_daily`
# and `python -m src.pipeline.run_backfill`.

# Storage — Supabase Postgres (project: Silo / zcjbtpxuhdekpwcxmepn)
# Apply schema once:  python scripts/apply_schema.py
# Get the connection string from: Supabase Dashboard -> Silo -> Connect.
#
# LOCAL (this form): direct connection (port 5432) — verified for DDL/migrations
#   and bulk upserts from psycopg2.
# CI / GitHub Actions: the direct host is IPv6-only and GH runners are IPv4-only,
#   so set the POSTGRES_URL secret to the IPv4-safe session pooler instead:
#   postgresql://postgres.zcjbtpxuhdekpwcxmepn:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres:<password>@db.zcjbtpxuhdekpwcxmepn.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:<password>@db.zcjbtpxuhdekpwcxmepn.supabase.co:5432/postgres?sslmode=require

# IPv4-safe session pooler URL — used by scripts/finish_cutover.sh to set the
# GitHub Actions POSTGRES_URL secret (the direct host above is IPv6-only and
# fails on GH runners). Leave blank for local-only use.
# SUPABASE_POOLER_URL=postgresql://postgres.zcjbtpxuhdekpwcxmepn:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# CVM fetcher network tuning
CVM_DNS_NAMESERVERS=1.1.1.1,8.8.8.8,9.9.9.9
CVM_REQUEST_TIMEOUT=300
CVM_MAX_RETRIES=3
CVM_RETRY_DELAY=5
CVM_UPSERT_CHUNK_SIZE=1000
CVM_INGEST_CONCURRENCY=4
CVM_DAILY_CONCURRENCY=6
CVM_DAILY_SCOPE=core

# B3 COTAHIST (public historical quotation zips)
# B3_COTAHIST_BASE_URL=https://bvmf.bmfbovespa.com.br/InstDados/SerHist
# B3_DAILY_LOOKBACK_DAYS=7
# B3_REQUEST_TIMEOUT=300
# B3_MAX_RETRIES=3

# Misc
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# Flask control plane (local dev only — bind to 127.0.0.1)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=1

# Public read API (`python -m serve.app`). Prefer a role that can only
# SELECT/EXECUTE api.* — never the ingest postgres user in production.
# SILO_API_DATABASE_URL=postgresql://silo_api:<password>@db.zcjbtpxuhdekpwcxmepn.supabase.co:5432/postgres?sslmode=require
# SILO_API_HOST=127.0.0.1
# SILO_API_PORT=8080
