# Brazilian Financial Data pipeline — fetch / parse / store only.
# Copy to .env and fill in. Used by `python -m src.pipeline.run_daily`
# and `python -m src.pipeline.run_backfill`.

# Storage — Supabase Postgres (project: zcjbtpxuhdekpwcxmepn)
# Apply schema once:  psql $POSTGRES_URL -f src/store/schema.sql
# Use the Session pooler (port 5432) — IPv4, and happiest for DDL/migrations and
# execute_values bulk upserts. The user is "postgres.<project-ref>", not "postgres".
# (scripts/db_parity.py and scripts/_check_conn.py rewrite :6543 -> :5432 defensively,
#  so a transaction-pooler string also works for those checks.)
POSTGRES_URL=postgresql://postgres.zcjbtpxuhdekpwcxmepn:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# CVM fetcher network tuning
CVM_DNS_NAMESERVERS=1.1.1.1,8.8.8.8,9.9.9.9
CVM_REQUEST_TIMEOUT=300
CVM_MAX_RETRIES=3
CVM_RETRY_DELAY=5
CVM_UPSERT_CHUNK_SIZE=1000
CVM_INGEST_CONCURRENCY=4
CVM_DAILY_CONCURRENCY=6
CVM_DAILY_SCOPE=core

# Misc
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# Flask control plane (local dev only — bind to 127.0.0.1)
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=1
