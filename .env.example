# Brazilian Financial Data pipeline — fetch / parse / store only.
# Copy to .env and fill in. Used by `python -m src.pipeline.run_daily`
# and `python -m src.pipeline.run_backfill`.

# Storage — Supabase (project that owns the schema in src/store/schema.sql)
# Apply once:  psql $SUPABASE_DB_URL -f src/store/schema.sql
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>

# CVM fetcher network tuning
CVM_DNS_NAMESERVERS=1.1.1.1,8.8.8.8,9.9.9.9
CVM_REQUEST_TIMEOUT=300
CVM_MAX_RETRIES=3
CVM_RETRY_DELAY=2

# Misc
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
