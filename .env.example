# CVM API
CVM_DNS_NAMESERVERS=1.1.1.1,8.8.8.8,9.9.9.9

# B3 CALC API
B3_CALC_BASE_URL=https://calculadorarendafixa.com.br/webservice

# BACEN API
BACEN_API_HOST=0.0.0.0
BACEN_API_PORT=8002

# Rate limiting (not yet wired)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Cache
CACHE_TTL=3600

# Timezone / Logging
TZ=America/Sao_Paulo
LOG_LEVEL=INFO

# PostgreSQL (DB Foundation — Phase 1)
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://postgres:changeme_in_production@db:5432/iliquid
CVM_DATABASE_URL=postgresql+asyncpg://cvm_user:cvm_secret@db:5432/iliquid
BACEN_DATABASE_URL=postgresql+asyncpg://bacen_user:bacen_secret@db:5432/iliquid
B3_CALC_DATABASE_URL=postgresql+asyncpg://b3_calc_user:b3_secret@db:5432/iliquid

# Supabase (Ingestor — Part 1)
# Apply schema first: psql $SUPABASE_DB_URL -f src/ingestor/schema.sql
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>

# Delos Oracle — Solana (Part 2)
# Populate after: anchor build && anchor deploy --provider.cluster devnet
ORACLE_KEYPAIR_JSON=<json-array-of-64-bytes>
SOLANA_RPC_URL=https://api.devnet.solana.com
ANCHOR_PROGRAM_ID=<program-id-after-deploy>
# React dashboard (set in delos-oracle/app/.env.local)
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_PROGRAM_ID=<program-id-after-deploy>
# VITE_ORACLE_AUTHORITY=<authority-pubkey>
