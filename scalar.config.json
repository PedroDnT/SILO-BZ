{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "SILO — Brazilian Financial Data"
  },
  "siteConfig": {
    "subdomain": "silo-bz",
    "theme": "default",
    "favicon": "scalar/favicon.ico"
