        "type": "group",
        "title": "Getting Started",
        "mode": "flat",
        "children": {
          "": {
            "type": "page",
            "title": "Introduction",
            "filepath": "scalar/introduction.md"
          },
          "/quickstart": {
            "type": "page",
            "title": "Quickstart",
            "filepath": "scalar/quickstart.md"
          },
          "/authentication": {
            "type": "page",
            "title": "Authentication",
            "filepath": "scalar/auth.md"
          },
          "/concepts": {
            "type": "page",
            "title": "Core concepts",
            "filepath": "scalar/concepts.md"
          }
        }
      },
      "/guides": {
        "type": "group",
        "title": "Research guides",
        "children": {
          "/guides/research-universe": {
            "type": "page",
            "title": "Research universe",
            "filepath": "scalar/guides/research-universe.md"
          },
          "/guides/point-in-time": {
            "type": "page",
            "title": "Point-in-time fundamentals",
            "filepath": "scalar/guides/point-in-time.md"
