          "/guides/total-return": {
            "type": "page",
            "title": "Total-return prices",
            "filepath": "scalar/guides/total-return.md"
          },
          "/guides/macro": {
            "type": "page",
            "title": "Macro and inflation",
            "filepath": "scalar/guides/macro.md"
          },
          "/guides/fidc": {
            "type": "page",
            "title": "FIDC credit analysis",
            "filepath": "scalar/guides/fidc.md"
          }
        }
      },
      "/api": {
        "type": "openapi",
        "title": "API Reference",
        "filepath": "openapi.json",
        "mode": "nested"
      }
    }
