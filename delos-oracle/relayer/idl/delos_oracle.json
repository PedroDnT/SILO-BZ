{
  "version": "0.1.0",
  "name": "delos_oracle",
  "instructions": [
    {
      "name": "initialize",
      "accounts": [
        { "name": "authority", "isMut": true, "isSigner": true },
        { "name": "macroState", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "updateMacroState",
      "accounts": [
        { "name": "authority", "isMut": false, "isSigner": true },
        { "name": "macroState", "isMut": true, "isSigner": false }
      ],
      "args": [
        { "name": "selicMeta",   "type": "i64" },
        { "name": "selicDiaria", "type": "i64" },
        { "name": "cdi",         "type": "i64" },
        { "name": "ipca",        "type": "i64" },
        { "name": "igpm",        "type": "i64" },
        { "name": "usdbrl",      "type": "i64" },
        { "name": "updatedTs",   "type": "i64" }
      ]
    }
  ],
  "accounts": [
    {
      "name": "MacroState",
      "type": {
        "kind": "struct",
        "fields": [
          { "name": "authority",   "type": "publicKey" },
          { "name": "selicMeta",   "type": "i64" },
          { "name": "selicDiaria", "type": "i64" },
          { "name": "cdi",         "type": "i64" },
          { "name": "ipca",        "type": "i64" },
          { "name": "igpm",        "type": "i64" },
          { "name": "usdbrl",      "type": "i64" },
          { "name": "updatedTs",   "type": "i64" },
          { "name": "slot",        "type": "u64" },
          { "name": "bump",        "type": "u8" }
        ]
      }
    }
  ],
  "events": [
    {
      "name": "MacroStateUpdated",
      "fields": [
        { "name": "authority",  "type": "publicKey", "index": false },
        { "name": "selicMeta",  "type": "i64",       "index": false },
        { "name": "ipca",       "type": "i64",       "index": false },
        { "name": "usdbrl",     "type": "i64",       "index": false },
        { "name": "updatedTs",  "type": "i64",       "index": false },
        { "name": "slot",       "type": "u64",       "index": false }
      ]
    }
  ],
  "errors": [
    { "code": 6000, "name": "Unauthorized", "msg": "Caller is not the oracle authority for this PDA" }
  ],
  "metadata": {
    "address": "DeLoSXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
  }
}
