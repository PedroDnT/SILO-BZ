{
  "permissions": {
    "allow": [
      "Bash(python scripts/explore_cvm_output.py)",
      "Bash(python3 scripts/explore_cvm_output.py)",
      "Bash(pip3 install *)",
      "Bash(pyenv versions *)",
      "Bash(python3.12 -c \"import aiofiles; import aiohttp; import pandas; print\\('deps OK'\\)\")",
      "Bash(python3.12 -m pip install -r requirements.txt -q)",
      "Bash(uv --version)",
      "Bash(uv venv *)",
      "Bash(uv pip *)",
      "Bash(.venv/bin/python scripts/explore_cvm_output.py)",
      "Bash(.venv/bin/pytest tests/test_cvm_fetch_parse.py -v)",
      "Bash(iconv *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/python -m py_compile *)",
      "Bash(prettier *)",
      "Bash(git push origin --delete claude/*)",
      "Bash(git push origin --delete cclaude/*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)",
      "mcp__github__pull_request_read",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__list_pull_requests",
      "mcp__github__get_job_logs",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_pull_requests",
      "mcp__Vercel__get_deployment",
      "mcp__Vercel__get_deployment_build_logs",
      "WebSearch",
      "WebFetch",
      "mcp__Parallel_Search__web_fetch",
      "mcp__Parallel_Search__web_search",
      "mcp__Exa__web_fetch_exa",
      "Bash(git fetch *)",
      "Bash(git merge-tree *)",
      "Bash(git ls-tree *)",
      "Bash(pg_lsclusters *)",
      "Bash(getent *)",
      "mcp__claude-code-remote__list_events",
      "Bash(gh run watch *)",
      "Bash(brew list *)",
      "mcp__ccd_pr__get_status",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__ccd_session_mgmt__search_session_transcripts",
      "mcp__claude_ai_Supabase__query_logs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-docs.sh\"",
            "timeout": 30,
            "statusMessage": "docs check…"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/npm-cwd-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit.sh",
            "timeout": 300,
            "statusMessage": "py_compile / pytest…"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' | { read -r f; case \"$f\" in */docs/planning/CHANGELOG.md|docs/planning/CHANGELOG.md|*/docs/archive/changelog/*|docs/archive/changelog/*|*/docs/planning/changelog.d/*|docs/planning/changelog.d/*) ;; *.md|*.json|*.yaml|*.yml) command -v prettier >/dev/null && prettier --write --log-level silent \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "prettier…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"",
            "timeout": 20,
            "statusMessage": "main + open PRs…"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true
  }
}
