{
  "enabled": true,
  "name": "Sync Docs on Code Change",
  "description": "Monitors Python source files and configuration files for changes, then prompts the agent to update relevant documentation in README.md or the docs/ folder",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.py",
      "*.py",
      "requirements.txt",
      "requirements-vercel.txt",
      "vercel.json",
      "mint.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file has been modified. Please review the changes and update the relevant documentation in either README.md, the docs/ folder, or the appropriate .mdx documentation files to reflect any API changes, new features, or modified functionality."
  }
}