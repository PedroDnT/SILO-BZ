        "description": "Deployed preview. What did the company file? Income, balance sheet, cash flow, headline figures and every stored version.\n\none row per filed period, with period_months.\n\nThis playground selects `cashflow` on `GET /statements`. See the [full resource reference](/api-docs/v2/reference/statements) for all variants.",
        "x-mint": {
          "href": "/api-docs/v2/operations/statements/cashflow"
        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "description": "Selects cash flow statements.",
            "schema": {
              "type": "string",
              "enum": [
                "cashflow"
              ],
              "default": "cashflow"
            },
            "example": "cashflow"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "quarterly: ITR filings. annual: DFP filings. A quarterly filing holds the 3-month and the year-to-date figure; period_months on the row says which. Never add the two. Default: both.",
            "schema": {
              "type": "string",
              "enum": [
                "both",
                "quarterly",
                "annual"
              ],
              "default": "both"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Consolidated and individual are separate filings of the same period; they are never merged. Default: consolidated.",
            "schema": {
              "type": "string",
              "enum": [
                "consolidated",
                "individual"
              ],
              "default": "consolidated"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "By kind: all, income, balance, cashflow, headline, versions take a listed company's ticker, 14-digit CNPJ or CVM code. With no id, kinds all, income, balance, cashflow, headline, versions read api.research_universe (what SILO holds). Default: none.",
            "schema": {
              "type": "string"
            },
            "example": "PETR4"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Start date (YYYY-MM-DD). Omit to use this resource's default window.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "End date (YYYY-MM-DD). Omit to use the latest complete period.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows per page, capped by your tier. Check next_page_url and meta.tier_cap_reached for incomplete results.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor from next_page_url. Send it alone; it preserves the original filters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "description": "Point in time: only documents CVM received before this date, at the highest version known then. Not for kind versions. Default: none: the latest stored version of every document, which is NOT point in time.",
            "schema": {
              "type": "string",
              "format": "date"
            }
