              "reason",
              "message",
              "target",
              "innererror"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "bad_request",
                  "unknown_parameter",
                  "unknown_id",
                  "unauthorized",
                  "forbidden_for_tier",
                  "over_limit",
                  "rate_limited",
                  "timeout",
                  "unavailable",
                  "internal"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "row_cap",
                  "tier_cap",
                  null
                ],
                "description": "over_limit only: row_cap (over one 1,000-row page: narrow or page) or tier_cap (over the tier ceiling: narrow or sign in). Null otherwise."
              },
              "message": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "innererror": {
