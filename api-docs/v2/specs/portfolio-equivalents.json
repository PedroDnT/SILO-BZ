        },
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "description": "Selects etf equivalents.",
            "schema": {
              "type": "string",
              "enum": [
                "equivalents"
              ],
              "default": "equivalents"
            },
            "example": "equivalents"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "The page size. More rows than one page come through next_page_url, never cut silently; a call stops at the tier's rows-per-call cap with meta.tier_cap_reached. Default: the tier's page maximum (10 anonymous, 100 signed in); a larger value is coerced to it.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The opaque cursor from a previous next_page_url. It carries every other parameter: send it alone (another parameter with a different value is bad_request). Default: none: the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "required": false,
            "description": "Hidden parameter (`?help=all` lists it). fee_peers: dates the comparison and excludes later documents; it reads the latest Extrato, so it is not a historical backtest. equivalents: snapshots dated after it are not read. Default: today (the SQL default).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
