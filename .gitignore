.env
/.env
.vercel

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Runtime directories (generated at runtime, never committed)
cache/
temp/
data/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local Claude settings (may contain absolute paths / machine-specific MCP config)
.claude/settings.local.json
# Per-agent git worktrees — must not be tracked (they appear as gitlinks and break CI)
.claude/worktrees/
.claire/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Logs
*.log
.gstack/
# seed_local_db.py's offline DuckDB, plus the write-ahead log it leaves behind
# when a run is interrupted (the .duckdb pattern alone did not cover the .wal).
.local_db/

node_modules

# Evidence dashboard secrets and cache
dashboard/.env
dashboard/.evidence/
webapp/.evidence/

# stray Evidence scaffold (degit template) — not part of the pipeline
evi/

# Per-tool agent/editor config — kept locally, not published to the repo.
# .claude/ stays tracked: it carries the shared settings.json, the post-edit
# hook and the SILO skill that CI and every contributor rely on.
.agents/
.codex/*
!.codex/coordination/
.vscode/
.taskplane/

.codex/coordination/*
!.codex/coordination/project.yaml

# Local agent and tool state. Until 2026-09-30 these were hidden only by one
# checkout's .git/info/exclude, so a fresh clone or worktree showed them as
# untracked.
.context/
.conductor/settings.local.*
**/.claude/scheduled_tasks.*
**/.claude/routines/.state/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json

# A .venv symlink (not only a directory) must never be tracked (#719 committed one).
.venv
