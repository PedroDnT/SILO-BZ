# Evidence dashboard — Supabase Postgres source.
# Copy to `dashboard/.env` (gitignored) and fill in the real password.
#
# Evidence loads the `supabase` source (dashboard/sources/supabase/connection.yaml)
# from this env var. The var name encodes the source name:
#   EVIDENCE_SOURCE__<source name>__<option>
# Use the discrete host/port/database/user/password options: the build's
# preflight (scripts/preflight.js) requires them and refuses a connectionString
# alone. dashboard/README.md "Required environment variables" lists the same set.
#
# Project: zcjbtpxuhdekpwcxmepn
#
EVIDENCE_SOURCE__supabase__host=[YOUR-HOST]
EVIDENCE_SOURCE__supabase__port=5432
EVIDENCE_SOURCE__supabase__database=postgres
EVIDENCE_SOURCE__supabase__user=[YOUR-USER]
EVIDENCE_SOURCE__supabase__password=[YOUR-PASSWORD]
